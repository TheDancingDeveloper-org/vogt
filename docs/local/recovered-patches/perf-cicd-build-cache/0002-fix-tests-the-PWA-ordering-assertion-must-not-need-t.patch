-    reason=(
-        "the merged tree carries the engine's deploy scripts; "
-        "a core-only checkout does not"
-    ),
-)
-
 
 @needs_engine
 def test_a_sessions_own_endpoint_is_what_its_agent_is_registered_against() -> None:
