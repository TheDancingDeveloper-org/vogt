+      # `build.yml` and `release.yml` pass the digest from `outputs.image` —
+      # and `docs/DEPLOYMENT.md` §9 says so where the hand-build is documented.
+      - name: point the convenience alias at it
+        env:
+          VARIANT: ${{ matrix.variant }}
+          IMAGE: ${{ steps.resolve.outputs.image }}
+        run: |
+          set -euo pipefail
+          docker buildx imagetools create --tag "${POD_IMAGE}:${VARIANT}" "$IMAGE"
+          echo "${POD_IMAGE}:${VARIANT} -> ${IMAGE}"
+
+      - name: summary
+        env:
+          REF: ${{ steps.tag.outputs.ref }}
+          IMAGE: ${{ steps.resolve.outputs.image }}
+          BUILT: ${{ steps.probe.outputs.exists != 'true' }}
+        run: |
+          {
+            if [ "$BUILT" = "true" ]; then
+              echo "### Built \`${REF}\`"
+            else
+              echo "### Reused \`${REF}\` (already published)"
+            fi
+            echo
+            echo '```'
+            echo "${IMAGE}"
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
