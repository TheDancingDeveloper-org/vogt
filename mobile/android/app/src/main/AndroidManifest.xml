<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".VogtApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Held only while a voice conversation is active (FR-M6): keeps the
            process alive across screen-off so the assistant socket, audio
            capture and TTS survive. Not exported — only MainActivity's bridge
            starts it. `microphone` because a conversation uses the mic through
            the WebView; `dataSync` because the socket must keep running.
        -->
        <service
            android:name=".VoiceConversationService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ requires runtime notification permission for FCM alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Assistant voice input (speech-recognition plugin) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        Foreground service held for the duration of an active voice conversation
        (FR-M6). The typed permissions match the service's declared
        foregroundServiceType and are required on API 34+.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Keep the CPU alive so the assistant socket survives screen-off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
