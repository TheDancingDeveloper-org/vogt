{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // NFR-Q5: Vogt's own dependencies practice what the product preaches.
  // The three things Vogt will report on for other projects (FR-D6) are
  // three *independent* toggles, never one boolean — so all three are
  // enabled here explicitly, by name.
  //
  //   1. version updates          — the scheduled PRs below
  //   2. vulnerability alerts     — osvVulnerabilityAlerts
  //   3. automated security fixes — vulnerabilityAlerts.enabled

  timezone: "Etc/UTC",
  schedule: ["before 5am on monday"],
  labels: ["dependencies"],
  semanticCommits: "disabled",

  // 2. Alerts: OSV advisories raise a PR regardless of the weekly window.
  osvVulnerabilityAlerts: true,

  // 3. Fixes: security updates are not held for the schedule.
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["dependencies", "security"],
    schedule: null,
  },

  // Keep uv.lock fresh even when no manifest range moved; CI fails on a
  // manifest/lockfile mismatch, so the lockfile is not optional here.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 5am on monday"],
  },

  // Base images move by digest, not by tag. A pinned digest is the only
  // form of "which image is this" that a rebuild cannot silently change —
  // and Vogt reports exactly this gap on other repositories (FR-D6), so
  // leaving its own base floating would be hard to defend.
  pinDigests: true,

  // The private engine bases are pulled from this organisation's GHCR mirror
  // rather than from Docker Hub (#33 — a self-hosted runner is one IP, the anonymous
  // per-IP allowance ran out mid-afternoon, and authenticating measurably
  // made it worse because the credential is estate-wide). The mirror name is
  // the upstream name with `docker.io/library/` replaced, and this teaches
  // Renovate the substitution so a digest bump still comes from *upstream*
  // rather than from whatever this organisation last mirrored — which would
  // be a version check that can only ever agree with itself.
  //
  // The same rule is applied in the other direction by
  // `.github/workflows/mirror-base-images.yml`, which derives what to copy
  // from the Dockerfiles. Changing the prefix means changing both.
  //
  // If this ever stops matching, the failure is that the bases quietly go
  // stale — Renovate finds nothing newer in the mirror and raises no PR. It
  // is not a broken build, but it is invisible, so check here first when a
  // base image has not moved in a suspiciously long time.
  registryAliases: {
    "ghcr.io/thedancingdeveloper-org/vogt-base": "docker.io/library",
  },

  // The engine image installs three npm CLIs, and they are pinned as ARGs
  // rather than floating on `latest` — see the note above them in
  // `engine/Dockerfile`. Nothing tracks a version inside a `RUN` by default,
  // so this teaches Renovate to read the annotation that sits above each one:
  //
  //     # renovate: datasource=npm depName=@openai/codex
  //     ARG CODEX_VERSION=0.148.0
  //
  // If this ever stops matching, the failure is silent in the same way the
  // registryAlias failure is: the pins simply go stale and no PR is raised.
  // Check here first if one of them has not moved in a suspiciously long
  // time. (On a Renovate older than the `managerFilePatterns` rename, this
  // key is spelled `fileMatch`.)
  customManagers: [
    {
      customType: "regex",
      description: "npm CLIs pinned as ARGs in the engine image",
      managerFilePatterns: ["/^engine/Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+ARG [A-Z_]+_VERSION=(?<currentValue>\\S+)",
      ],
    },
  ],

  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      // The dev toolchain moves together and is not shipped to anyone.
      matchDepTypes: ["dev"],
      groupName: "dev dependencies",
    },
    {
      // Both stages of the Dockerfile use the same base, so a digest bump
      // that lands on one and not the other would build the runtime from a
      // different image than the build. One PR, both lines.
      matchManagers: ["dockerfile"],
      groupName: "container base image",
    },
  ],
}
