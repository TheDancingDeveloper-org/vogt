# Image-managed CLI versions. Renovate updates these pins; image builds copy
# the resolved manifest into the image so the version that was tested is
# inspectable at runtime.
# renovate: datasource=npm depName=@openai/codex
VOGT_CODEX_VERSION=0.160.0
# renovate: datasource=npm depName=@anthropic-ai/claude-code
# 2.1.258, not npm's `stable` (still 2.1.236): Claude Fable 5.1
# (`claude-fable-5-1`) was added in 2.1.257, so an older pin cannot select the
# current default model from inside a pod — and the pin is deliberately
# unwalkable at runtime, so a stale one can only be fixed by a rebuild.
# The `claude --version` check in engine/Dockerfile guards the reason 2.1.236
# was held in the first place.
VOGT_CLAUDE_CODE_VERSION=2.1.289
# renovate: datasource=npm depName=opencode-ai
# Managed like the two above since WI-929: it used to come from the pod base's
# `curl opencode.ai/install | bash`, unpinned and with no runtime pin or uplift.
VOGT_OPENCODE_VERSION=1.18.31
# The Go toolchain (WI-951): baked from go.dev's release tarball, checked
# against the sha256s below rather than one fetched beside the download, so a
# bump is a deliberate edit of all three lines — and deliberately carries no
# `# renovate:` annotation, because an automerged version bump without its
# checksums would fail the image build. A runtime pin
# (`VOGT_GO_VERSION` in the environment) is checked against go.dev's own
# release index instead, the same trust npm gives the CLIs above.
VOGT_GO_VERSION=1.27.1
VOGT_GO_SHA256_LINUX_AMD64=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
VOGT_GO_SHA256_LINUX_ARM64=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec
# Klaudia (WI-950), a Go coding agent built from source: no registry publishes
# it, so the pin is a full commit of the repository below, built with the Go
# toolchain above (CGO off, `-trimpath`). A runtime pin (`VOGT_KLAUDIA_VERSION`
# in the environment) is another full commit, built into the volume at start.
VOGT_KLAUDIA_SOURCE=https://github.com/TheDancingDeveloper-org/msp-klaudia
VOGT_KLAUDIA_VERSION=c3ada6026adb68e372a72e00ff1a0d8e60d2c5db
