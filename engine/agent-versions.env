# Image-managed CLI versions. Renovate updates these pins; image builds copy
# the resolved manifest into the image so the version that was tested is
# inspectable at runtime.
# renovate: datasource=npm depName=@openai/codex
VOGT_CODEX_VERSION=0.149.1
# renovate: datasource=npm depName=@anthropic-ai/claude-code
# 2.1.258, not npm's `stable` (still 2.1.236): Claude Fable 5.1
# (`claude-fable-5-1`) was added in 2.1.257, so an older pin cannot select the
# current default model from inside a pod — and the pin is deliberately
# unwalkable at runtime (#196), so a stale one can only be fixed by a rebuild.
# The `claude --version` check in engine/Dockerfile guards the reason 2.1.236
# was held in the first place (#147/#148, #505).
VOGT_CLAUDE_CODE_VERSION=2.1.258
# renovate: datasource=npm depName=theclawbay
VOGT_THECLAWBAY_VERSION=0.6.13
