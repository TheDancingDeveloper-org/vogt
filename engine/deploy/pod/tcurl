#!/usr/bin/env bash
# curl through the tailnet SOCKS5 (WI-4716, WI-4721): tcurl https://node-e:8120/...
# DNS happens at the proxy (socks5h), so tailnet names resolve. Only this
# command is proxied; nothing sets a global proxy. The proxy is
# VOGT_TAILNET_SOCKS5, default the engine's vogt-dev-engine.vogt-dev.svc:1055.
set -eu
proxy="${VOGT_TAILNET_SOCKS5:-vogt-dev-engine.vogt-dev.svc:1055}"
exec curl --proxy "socks5h://${proxy}" "$@"
