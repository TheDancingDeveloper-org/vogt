# Public/local Compose settings. Copy to deploy/.env before starting the
# example: `cp deploy/.env.example deploy/.env`.

# The URL clients use to reach this instance. This is intentionally explicit:
# Vogt cannot infer a host address from inside a container.
VOGT_PUBLIC_URL=http://localhost:8080

# Host port allocation. Change this if 8080 is already in use — including by
# another instance of Vogt. Running a second instance on one host means giving
# it its own port, its own VOGT_PUBLIC_URL and its own Compose project name
# (`docker compose -p <name>`), which is what keeps its volume and network
# separate from the first one's. See docs/CUSTOMISATION.md, "Running a second
# instance on the same host".
VOGT_PORT=8080

# Which host interface the port is published on. Loopback by default — set
# this to a real address only when you mean to expose the instance.
VOGT_BIND_IP=127.0.0.1

# The image to run. Pin a digest in anything you would call a deployment.
# Ignored when you add deploy/vogt.build.yml, which builds from the checkout.
# VOGT_IMAGE=ghcr.io/thedancingdeveloper-org/vogt:v0.2.0

# The uid the container runs as. The gid is always 0 — that is what makes the
# data directory writable at any uid. Set this to whoever owns the files this
# instance observes.
VOGT_UID=1000

# Optional tuning.
VOGT_LOG_LEVEL=info
