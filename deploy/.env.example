# Settings for the *contributor* stack (`vogt.compose.yml`, `vogt.build.yml`,
# `engine.overlay.yml`) — a core and an engine run from a checkout. Copy to
# deploy/.env before starting it: `cp deploy/.env.example deploy/.env`.
#
# Deploying Vogt uses `stack.compose.yml` and `stack.env.example` instead.

# The URL clients use to reach this instance. This is intentionally explicit:
# Vogt cannot infer a host address from inside a container.
VOGT_PUBLIC_URL=http://localhost:8080

# Host port allocation. Change this if 8080 is already in use — including by
# another instance of Vogt. Running a second instance on one host means giving
# it its own port, its own VOGT_PUBLIC_URL and its own Compose project name
# (`docker compose -p <name>`), which is what keeps its volume and network
# separate from the first one's. See docs/CUSTOMISATION.md, "Running a second
# instance on the same host".
VOGT_PORT=8080

# Which host interface the port is published on. Loopback by default — set
# this to a real address only when you mean to expose the instance.
VOGT_BIND_IP=127.0.0.1

# The image to run. Pin a digest in anything you would call a deployment.
# Ignored when you add deploy/vogt.build.yml, which builds from the checkout.
# VOGT_IMAGE=ghcr.io/thedancingdeveloper-org/vogt:0.5.4

# The uid the container runs as. The gid is always 0 — that is what makes the
# data directory writable at any uid. Set this to whoever owns the files this
# instance observes.
VOGT_UID=1000

# Optional tuning.
VOGT_LOG_LEVEL=info


# ── Optional: session engine ────────────────────────────────────────────────
# Only needed when you add the engine overlay, which runs the Rust session
# engine (terminals, the PWA, the voice assistant) in front of the core:
#
#   docker compose -f deploy/vogt.compose.yml -f deploy/engine.overlay.yml up --build -d
#
# Leave this whole block untouched and the base still runs core-only.

# The engine's own bearer token, required by the engine and at least 16
# characters. Generate one and keep it here — this file is git-ignored, which
# is the file it lives in rather than your shell history. For stricter secret
# hygiene, put `token = "..."` in a mounted engine TOML config (ENGINE_CONFIG)
# instead and leave this unset; see docs/ENGINE.md.
#   ENGINE_TOKEN=$(openssl rand -hex 24)
ENGINE_TOKEN=

# Build the image-managed Codex and Claude CLIs into the engine image. Their
# reproducible versions come from engine/agent-versions.env; set
# VOGT_CODEX_VERSION only for a deliberate local override.
VOGT_INSTALL_AI_CLIENTS=false
# VOGT_CODEX_VERSION=
# VOGT_CLAUDE_CODE_VERSION=

# The host interface the engine's port is published on. Loopback by default —
# set this to a real address only when you mean to expose the engine. (This is
# the host side; inside the container the engine always listens on 0.0.0.0.)
ENGINE_BIND=127.0.0.1

# The host port for the engine. Change it if 8910 is already taken.
ENGINE_PORT=8910

# The URL clients reach the engine (the front door) at. Optional, but the
# engine cannot advertise an address it is not told.
# ENGINE_PUBLIC_URL=http://localhost:8910

# The core token both halves share, written to deploy/vogt-core-token so the
# engine can authenticate to the core in a single deploy:
#   openssl rand -hex 32 > deploy/vogt-core-token
# Who the adopted token acts as, and its scopes (defaults shown).
# VOGT_BOOTSTRAP_CORE_TOKEN_ACTOR=agent:engine
# VOGT_BOOTSTRAP_CORE_TOKEN_SCOPES=read,work.write,project.write

# Voice assistant provider (optional). Any OpenAI-compatible chat endpoint.
# With no key the assistant tab is hidden; a key with no base URL is an error.
# ENGINE_ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
# ENGINE_ASSISTANT_API_KEY=
# ENGINE_ASSISTANT_MODEL=

# Server-side speech (optional), independent of the chat provider. Empty means
# off, which is the default on this *contributor* stack (a core plus an engine
# built from a checkout — there is no bundled speech here).
#
# The supported all-in-one stack ships voice on out of the box: its
# `voice` sidecar carries a small default model set and
# `deploy/stack.compose.yml` wires the engine to it. See `deploy/stack.env.example`.
#
# On this contributor stack, turn voice on by naming any OpenAI-compatible audio
# endpoint below — a hosted provider (OpenAI, Groq, a proxy) or a `vogt-voice`
# / Whisper / Piper container you run yourself and reach by service name over
# the Compose network. The base URLs are an ordered fallback list, so you can
# list a local endpoint first and a cloud one after it. A key set against an
# empty list is a startup error. `TTS_FORMAT` is what the engine asks the TTS
# endpoint for: `mp3` for a cloud provider, `wav` for the first-party
# `vogt-voice` Piper backend, which serves only wav.
#
# ENGINE_ASSISTANT_STT_BASE_URLS=https://api.openai.com/v1
# ENGINE_ASSISTANT_STT_API_KEY=
# ENGINE_ASSISTANT_STT_MODEL=whisper-1
# ENGINE_ASSISTANT_TTS_BASE_URLS=https://api.openai.com/v1
# ENGINE_ASSISTANT_TTS_API_KEY=
# ENGINE_ASSISTANT_TTS_MODEL=tts-1
# ENGINE_ASSISTANT_TTS_VOICE=nova
# ENGINE_ASSISTANT_TTS_FORMAT=mp3
