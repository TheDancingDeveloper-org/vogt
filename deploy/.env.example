# Public/local Compose settings. Copy to deploy/.env before starting the
# example: `cp deploy/.env.example deploy/.env`.

# The URL clients use to reach this instance. This is intentionally explicit:
# Vogt cannot infer a host address from inside a container.
VOGT_PUBLIC_URL=http://localhost:8080

# Host port allocation. Change this if 8080 is already in use.
VOGT_PORT=8080

# Optional tuning.
VOGT_LOG_LEVEL=info
