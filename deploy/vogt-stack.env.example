# The merged stack's environment, as Komodo holds it (NFR-D11, NFR-D12).
#
# Paste the filled version into the Komodo stack's `environment` field; Komodo
# writes it to a `.env` beside the compose file at deploy time, which is what
# the `pre_deploy` hook reads to broker the two credential files.
#
# ── Read this before filling it in ────────────────────────────────────────
#
# **The compose file's defaults are production's, and this is a dev stack.**
# `vogt-stack.compose.yml` defaults the port to 18094 and the three bind
# mounts to `/mnt/2tnvme/docker/volumes/mydevenv2/...` — that is the port the
# core-only `personal/vogt` stack is serving on right now, and those are the
# volumes the running MyDevEnv2 stack owns. A dev stack that accepts those
# defaults does not stand beside production; it lands on top of it, and the
# first symptom is two processes writing one workspace.
#
# So every allocation below is set explicitly, even where a default exists.
# The rule from `DEPLOYMENT.md` §4.1 is that allocation values carry defaults
# so a deploy cannot fail on an unset variable — not that the defaults are
# right for a second instance of the same product.
#
# **The port is not allocated by this file.** §4.1: a port is verified free on
# Node B at the moment the stack is created, never inherited from a document.
# 18090 and 18092 are cadastre, 18094 is `personal/vogt`, and 18095 was
# already taken when 18094 was allocated. 18096 below is a *candidate*.
# Check it, and if it is taken, take the next free one and say so here.

# ── Allocation: where this instance lives ─────────────────────────────────

# Verify free on Node B before the first deploy (see above).
VOGT_PORT=18096
VOGT_BIND_IP=100.92.54.45

# Required, and correctly so: nothing inside the container can work out the
# URL clients reach it at (NFR-D2). This is the front door's own address, and
# it is what the PWA, the MCP registrations and every session's `VOGT_URL`
# resolve to.
VOGT_PUBLIC_URL=https://vogt-dev.tailc7d3c.ts.net:18096

# Its own tailnet identity. Sharing `vogt` with the core-only stack would give
# two hosts one name, which resolves to whichever registered last.
TAILSCALE_HOSTNAME=vogt-dev

# ── Allocation: state, and the reason each path is its own ────────────────
#
# Identity and state are this stack's own; the estate is shared.
#
# This started as three separate trees, on the grounds that pointing the
# workspace at production's is not "sharing data" — it is two engines opening
# PTYs in one set of working trees. That risk is real and is accepted, not
# forgotten: two agents can edit one checkout and git will not stop them.
#
# What the isolated version could not do was be useful. A dev instance whose
# estate is an empty directory has nothing to collect, nothing to import into
# and nothing to open a session on, which is the whole product; `~/Working`
# came up empty in `vogt-dev` and the stack could not be exercised at all
# (#22). A separate copy of the estate is worse than either: it drifts, and
# then the dev instance is reporting on trees nobody works in.
#
# So the workspace is the MyDevEnv2 stack's, read-write — collectors only
# read, but `project create` and `project import` write, and a `:ro` estate
# removes exactly those two operations at runtime rather than refusing them
# honestly. Home and tailscale stay private: shell history, credentials,
# agent state and a tailnet identity are this instance's own, and sharing
# them is how two pods overwrite each other's sessions.

VOGT_WORKSPACE_DIR=/mnt/2tnvme/docker/volumes/mydevenv2/workspace
VOGT_HOME_DIR=/mnt/2tnvme/docker/volumes/vogt-dev/home
VOGT_TAILSCALE_DIR=/mnt/2tnvme/docker/volumes/vogt-dev/tailscale

# Must be inside VOGT_WORKSPACE_DIR as the container sees it, or imported
# projects are invisible to sessions and to the collectors. `/readyz` reports
# this as `workspace_agreement` and the smoke script checks it (FR-E3).
VOGT_IMPORT_ROOT=/home/sprooty/Working/Active

# Which Infisical secret holds the Vogt token in-pod agents act with.
#
# One per *instance*, not one per estate. A Vogt token is minted by an
# instance and stored hashed in that instance's own database, so no other
# instance can recognise it and none can be taught to. This stack runs its
# own instance, so it needs its own token; the compose default names
# production's, which this stack must not use and could not use anyway.
#
# `HOMELAB_VOGT_DEV_AGENT_TOKEN` is bound to actor `agent:vogt-dev` with
# `read` + `work.write` on the instance in this stack's own volume. Leaving
# this unset is what made every in-pod agent's Vogt call fail with a rejected
# token, pointing at a token file that was perfectly correct (#29).
MYDEVENV2_VOGT_SECRET_NAME=HOMELAB_VOGT_DEV_AGENT_TOKEN

# ── Secrets ───────────────────────────────────────────────────────────────
#
# Sourced from Infisical `apps`/`prod` by hand and pasted here — Komodo does
# not read Infisical. Every one of these is point-in-time: rotating upstream
# does not reach the stack until somebody redeploys it, so alert on the
# symptom (auth failures at the consumer) rather than on the age of the copy.

# The front door's primary bearer token. `openssl rand -hex 32`.
MYDEVENV2_TOKEN=

# Read by the `pre_deploy` hook into `./github-token`, mounted at
# /run/secrets/github_token. Without it the forge adapter is off and a private
# repository cannot be imported — silently, because forge subjects then read
# as "not collected" rather than absent (NFR-PO1).
VOGT_GITHUB_TOKEN=

# Read by the hook into `./vogt-core-token`, mounted at
# /run/secrets/vogt_core_token. **Chicken-and-egg on a first deploy, and that
# is expected**: bring the stack up with this empty, then
#     docker exec vogt-dev vogt token issue --actor <you> --name front-door \
#         --scopes read,work.write --reason "front door pairing"
# and put the value here, redeploy. Until then `/api/vogt` writes refuse with
# a named reason (FR-S9) and everything else works.
VOGT_CORE_TOKEN=

# Agent auth inside sessions. Required by the compose — a session that cannot
# broker credentials is a session whose agent cannot use git or gh.
HOMELAB_MYDEVENV2_INFISICAL_CLIENT_ID=
HOMELAB_MYDEVENV2_INFISICAL_CLIENT_SECRET=

# Reusable preauth key from https://login.tailscale.com/admin/settings/keys.
# Empty means no tailnet identity: reachable on the bind IP and nowhere else.
HOMELAB_MYDEVENV2_TAILSCALE_AUTH_KEY=

# Optional. Empty disables the assistant routes entirely and hides the PWA tab
# (FR-T6), which is a reasonable state for a dev stack to start in.
MYDEVENV2_ASSISTANT_API_KEY=

# ── Optional, with defaults that are already right ────────────────────────
#
# Listed so the set is complete rather than because they need changing.

# INFISICAL_API_URL=http://100.92.54.45:8400
# CONTEXTKEEPER_URL=
# CONTEXTKEEPER_API_TOKEN=
# CONTEXTKEEPER_IP=100.92.54.45
# GUI_STREAM_URL=
# START_SWAY=0
# RUST_LOG=info
# VOGT_LOG_LEVEL=info
# VOGT_LOG_FORMAT=text
# VOGT_LOG_REQUESTS=true
# VOGT_LOG_SLOW_REQUEST_MS=1000
# SCCACHE_REDIS=redis://100.92.54.45:6380
# DOCKER_SOCKET_GID=984
