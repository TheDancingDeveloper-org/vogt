# Extra engine env for scripts/smoke-pod (ops apps/vogt-smoke). The harness
# already sets VOGT_ENGINE_POD_{NAMESPACE,IMAGE,SERVICE_ACCOUNT,IMAGE_PULL_SECRET}
# and the engine reads them as aliases of ENGINE_POD_*.
ENGINE_POD_BACKENDS_ENABLED=true
# The smoke engine is reached over plain http inside the cluster.
ENGINE_POD_ENGINE_ENDPOINT=http://vogt-smoke-engine.vogt-smoke.svc:8910
ENGINE_POD_ALLOW_INSECURE_ENDPOINT=true
# The smoke namespace has no cache objects or priority class.
ENGINE_POD_PRIORITY_CLASS=
ENGINE_POD_CACHE_PVC=
ENGINE_POD_CACHE_NODE=
ENGINE_POD_CACHE_ENV_CONFIG_MAP=
ENGINE_POD_CACHE_SECRET=
ENGINE_POD_KACHE_CONFIG_MAP=
# Fit the vogt-smoke-sessions quota.
ENGINE_POD_RESOURCE_REQUESTS=cpu=100m,memory=256Mi,ephemeral-storage=1Gi
ENGINE_POD_RESOURCE_LIMITS=cpu=1,memory=1Gi,ephemeral-storage=4Gi
ENGINE_POD_CLI=claude
ENGINE_POD_ENGINE_ID=vogt-smoke
# The in-cluster graft-dev Service; the session-egress NetworkPolicy allows :17888.
ENGINE_POD_GRAFT_ENDPOINT=http://graft-dev.graft-dev.svc:17888
# Path of the mounted read-only graft token (scope repo:vogt:read, ops #246;
# this file holds a path, never a value).
ENGINE_POD_GRAFT_TOKEN_FILE=/run/vogt-smoke/graft-token
