# Sourced by scripts/smoke-pod. The "Pod" template is a built-in default
# (backend=pod, no command of its own). The smoke has no Claude login, so it
# asks for a login shell in the PTY; the entrypoint still boots, clones and
# seeds the brief before the agent spawns it.
SESSION_SPEC='{"name":"__NAME__","template":"Pod","command":["bash","-l"]}'
BOOT_MARKER='session-entrypoint: boot completed'
